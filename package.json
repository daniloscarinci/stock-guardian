{
  "name": "stock-guardian",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Stock Guardian - Offline Preparedness & Resource Management",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:catalog && tsc --noEmit && vite build && npm run audit:offline",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate:catalog": "node scripts/extract-legacy-catalog.mjs",
    "audit:offline": "node scripts/audit-offline.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "generate:sample": "node scripts/generate-sample-backup.mjs",
    "tauri": "tauri",
    "generate:android-icons": "node scripts/generate-android-icons.mjs",
    "generate:android-key": "node scripts/generate-android-key.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^15.15.0",
    "happy-dom": "^20.0.0",
    "node-forge": "^1.4.0",
    "playwright": "^1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
